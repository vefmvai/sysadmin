#!/usr/bin/env bash
# .githooks/pre-commit — версионируемый pre-commit hook репо sysadmin.
#
# ЗАЧЕМ. Две независимые проверки целостности перед коммитом:
#  1) ПЕРСОНА (CLAUDE.md ↔ references/*.md; ADR-0015) — рассинхрон слоёв = неправильное
#     действие агента на старте (инциденты v1.9.1–v1.9.3). + бюджет ядра CLAUDE.md (ADR-0016).
#  2) ЗНАНИЯ (.claude/knowledge/) — целостность базы: валидный frontmatter (иначе файл
#     невидим для контроля свежести), битые путевые ссылки, сироты (ADR-0003/0006).
#
# Хук версионируется (лежит в репо), активируется один раз:
#   git config core.hooksPath .githooks
# Эту строку добавляют sysadmin-init / bootstrap-new-server при настройке.
#
# Обход в исключительном случае (НЕ по привычке): git commit --no-verify

set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
STAGED="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)"
FAIL=0

# ===========================================================================
# 1. ПЕРСОНА — бюджет ядра + синхрон слоёв (только если коммит трогает персону)
# ===========================================================================
PERSONA_TOUCHED=0
case "$STAGED" in *"CLAUDE.md"*)                  PERSONA_TOUCHED=1 ;; esac  # ядро (ADR-0015)
case "$STAGED" in *".claude/agents/sysadmin.md"*) PERSONA_TOUCHED=1 ;; esac  # legacy/заглушка
case "$STAGED" in *".claude/agents/references/"*) PERSONA_TOUCHED=1 ;; esac

if [ "$PERSONA_TOUCHED" -eq 1 ]; then
    # --- бюджет ядра CLAUDE.md (ADR-0016, анти-храповик) -------------------
    CLAUDE_BUDGET_BYTES=46000
    CLAUDEMD="$ROOT/CLAUDE.md"
    case "$STAGED" in
        *"CLAUDE.md"*)
            if [ -f "$CLAUDEMD" ]; then
                # Размер берём из ИНДЕКСА, а не из рабочего дерева. На Windows рабочая
                # копия хранится с CRLF, и `wc -c` насчитывает лишний байт на КАЖДУЮ
                # строку (~416 Б на этом файле) — бюджет ложно «превышался» на одной
                # платформе и спокойно проходил на другой. В репозитории всегда LF,
                # поэтому меряем то, что реально уйдёт в коммит. (PR #9, ostrovskid)
                BYTES="$(git -C "$ROOT" cat-file -s :CLAUDE.md 2>/dev/null)"
                [ -n "$BYTES" ] || BYTES="$(wc -c < "$CLAUDEMD" | tr -d ' ')"
                if [ "$BYTES" -gt "$CLAUDE_BUDGET_BYTES" ]; then
                    echo "❌ pre-commit: CLAUDE.md = ${BYTES} Б > бюджет ${CLAUDE_BUDGET_BYTES} Б (ADR-0016)." >&2
                    echo "   Ядро грузится при каждом старте. Вынеси часть в references/ («одно входит — одно выходит»)," >&2
                    echo "   либо подними бюджет осознанно через ADR. Обход (редко): git commit --no-verify" >&2
                    FAIL=1
                fi
            fi
            ;;
    esac

    # --- линтер согласованности слоёв -------------------------------------
    LINTER="$ROOT/.claude/skills/_lib/check-persona-sync.sh"
    if [ ! -f "$LINTER" ]; then
        echo "⚠️  pre-commit: персона меняется, но линтер не найден ($LINTER) — пропускаю проверку." >&2
    else
        echo "pre-commit: коммит трогает персону → проверяю согласованность слоёв…" >&2
        if ! bash "$LINTER" --root "$ROOT" >&2; then
            echo >&2
            echo "❌ pre-commit: персона рассинхронизирована (выжимка ↔ references)." >&2
            echo "   Синхронизируй ядро CLAUDE.md и references/ (см. CLAUDE.md «персона двухслойна»)." >&2
            FAIL=1
        fi
    fi
fi

# ===========================================================================
# 2. ЗНАНИЯ — целостность базы (только если коммит трогает .claude/knowledge/)
# ===========================================================================
KNOWLEDGE_TOUCHED=0
case "$STAGED" in *".claude/knowledge/"*) KNOWLEDGE_TOUCHED=1 ;; esac

if [ "$KNOWLEDGE_TOUCHED" -eq 1 ]; then
    VALIDATOR="$ROOT/scripts/validate-knowledge.py"
    if [ ! -f "$VALIDATOR" ]; then
        echo "⚠️  pre-commit: knowledge меняется, но валидатор не найден ($VALIDATOR) — пропускаю." >&2
    elif ! command -v python3 >/dev/null 2>&1; then
        echo "⚠️  pre-commit: python3 не найден — пропускаю валидацию knowledge." >&2
        echo "   Для строгой проверки целостности базы знаний установи python3 (+ pip install pyyaml)." >&2
    else
        echo "pre-commit: коммит трогает knowledge → проверяю целостность базы…" >&2
        if ! ( cd "$ROOT" && python3 "$VALIDATOR" >&2 ); then
            echo >&2
            echo "❌ pre-commit: база знаний не прошла валидацию (frontmatter / битые ссылки)." >&2
            echo "   Почини по выводу выше. Обход (редко): git commit --no-verify" >&2
            FAIL=1
        fi
    fi
fi

# ===========================================================================
# 2а. МАРШРУТЫ README баз знаний (ADR-0037)
#     README работает маршрутизатором: «вопрос → открыть такой-то файл (§раздел)».
#     Агент идёт по маршруту и НЕ перепроверяет, есть ли там обещанное — в этом смысл
#     маршрутизатора и его цена. 05.08.2026 класс «маршрут обещает то, чего в файле
#     нет» всплыл семь раз за три круга проверки; validate-knowledge.py при этом был
#     зелёным все четыре круга, потому что проверяет существование пути, а не
#     содержимое по ссылке.
# ===========================================================================
# Триггер шире, чем у соседней секции: маршруты ведут и в `references/` скиллов, поэтому
# переименование файла в скилле способно убить маршрут, не тронув knowledge (найдено
# проверщиком 05.08.2026).
ROUTES_TOUCHED=0
case "$STAGED" in *".claude/knowledge/"*) ROUTES_TOUCHED=1 ;; esac
case "$STAGED" in *".claude/skills/"*)    ROUTES_TOUCHED=1 ;; esac

if [ "$ROUTES_TOUCHED" -eq 1 ]; then
    ROUTELINT="$ROOT/scripts/check-route-targets.sh"
    if [ ! -f "$ROUTELINT" ]; then
        echo "⚠️  pre-commit: маршруты меняются, но линтер не найден ($ROUTELINT) — пропускаю." >&2
    else
        echo "pre-commit: коммит трогает knowledge или скиллы → проверяю маршруты README…" >&2
        # --staged, а НЕ рабочее дерево: иначе «git add плохой версии → правка на диске»
        # даёт «чисто» при грязном коммите. Проверщик 05.08.2026 протащил так мёртвый §42.
        if ! ( cd "$ROOT" && bash "$ROUTELINT" --staged --quiet >&2 ); then
            echo >&2
            echo "❌ pre-commit: маршрутизатор обещает то, чего в целевом файле нет." >&2
            echo "   Открой файл и сверь: номер раздела и словарь вопроса." >&2
            echo "   Замок НЕ ловит смысловую инверсию и потерянный маршрут — это за чтением." >&2
            echo "   Обход (редко, осознанно): git commit --no-verify" >&2
            FAIL=1
        fi
    fi
fi

# ===========================================================================
# 2б. СХЕМА КАРТЫ ИНФРЫ — контракт infra-config.json (только если схема правится)
#     По этой схеме /sysadmin-init создаёт и проверяет конфиг в папке инфры оператора.
#     До 16.08.2026 тестов у неё не было, и правки проверялись глазами: «JSON
#     разбирается» принималось за «схема работает». Это разные вещи — файл может
#     успешно разбираться и при этом пропускать конфиг, который обязан отклонить.
#     Тест гоняет 20 случаев В ОБЕ СТОРОНЫ и помечает случаи исторических дефектов.
# ===========================================================================
SCHEMA_TOUCHED=0
case "$STAGED" in *"infra-config.schema.json"*) SCHEMA_TOUCHED=1 ;; esac

if [ "$SCHEMA_TOUCHED" -eq 1 ]; then
    SCHEMATEST="$ROOT/scripts/test-infra-config-schema.py"
    if [ ! -f "$SCHEMATEST" ]; then
        echo "⚠️  pre-commit: схема меняется, но тест не найден ($SCHEMATEST) — пропускаю." >&2
    elif ! command -v python3 >/dev/null 2>&1; then
        echo "⚠️  pre-commit: python3 не найден — пропускаю проверку схемы." >&2
    else
        echo "pre-commit: коммит трогает схему карты инфры → прогоняю тест…" >&2
        ( cd "$ROOT" && python3 "$SCHEMATEST" >&2 )
        SCHEMA_RC=$?
        if [ "$SCHEMA_RC" -eq 2 ]; then
            # Нет модуля jsonschema — проверить нечем. Не блокирую (на чужой машине
            # его может не быть), но и молча зелёным не притворяюсь.
            echo "⚠️  pre-commit: схему проверить нечем. Заведи окружение в корне репо:" >&2
            echo "     python3 -m venv .venv && ./.venv/bin/python3 -m pip install jsonschema" >&2
            echo "     (тест сам перезапустится в .venv; готовое окружение — SYSADMIN_VENV=/путь)" >&2
        elif [ "$SCHEMA_RC" -ne 0 ]; then
            echo >&2
            echo "❌ pre-commit: схема карты инфры ведёт себя не так, как задумано." >&2
            echo "   Разбери вывод выше: какой случай пропущен вместо отказа (или наоборот)." >&2
            echo "   Обход (редко, осознанно): git commit --no-verify" >&2
            FAIL=1
        fi
    fi
fi

# ===========================================================================
# 3. ПЕРЕНОСИМОСТЬ inline-кода скиллов и персоны (ADR-0028)
#    Код в ```bash-блоках агент вставляет в оболочку ОПЕРАТОРА, а на macOS это zsh.
#    Три бага этого класса уже стоили работы (живой прогон 2026-07-25): проверка
#    снимка inventory-scan объявляла валидный снимок битым; rotate-secrets не
#    перезапускал НИ ОДНОГО потребителя после смены пароля БД; гейт окружения
#    отказывал на маке с советом поставить Git for Windows.
# ===========================================================================
SHELLCODE_TOUCHED=0
case "$STAGED" in *".claude/skills/"*)            SHELLCODE_TOUCHED=1 ;; esac
case "$STAGED" in *".claude/agents/"*)            SHELLCODE_TOUCHED=1 ;; esac
case "$STAGED" in *".claude/knowledge/"*)         SHELLCODE_TOUCHED=1 ;; esac

if [ "$SHELLCODE_TOUCHED" -eq 1 ]; then
    PORTLINT="$ROOT/scripts/check-shell-portability.sh"
    if [ ! -f "$PORTLINT" ]; then
        echo "⚠️  pre-commit: скиллы меняются, но линтер переносимости не найден ($PORTLINT) — пропускаю." >&2
    else
        echo "pre-commit: коммит трогает скиллы → проверяю переносимость inline-кода…" >&2
        # Проверяем ТОЛЬКО staged md-файлы: чужие давние огрехи не должны блокировать
        # правку, к которой они не относятся.
        #
        # МАССИВ, а не строка с пробелами. Путь к репозиторию у оператора может
        # содержать пробелы (боевой случай: «…/Claude Code/sysadmin»), и склейка
        # путей в одну строку с последующим раскрытием без кавычек разбивает их
        # на куски — линтер получает несуществующие файлы и рапортует «чисто».
        # Поймано живым тестом замка 2026-07-25: плохой коммит прошёл насквозь.
        STAGED_MD=()
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            case "$f" in
                .claude/skills/*.md|.claude/agents/*.md|.claude/knowledge/*.md)
                    [ -f "$ROOT/$f" ] && STAGED_MD+=("$ROOT/$f") ;;
            esac
        done <<EOF
$STAGED
EOF
        if [ "${#STAGED_MD[@]}" -gt 0 ]; then
            if ! bash "$PORTLINT" --root "$ROOT" "${STAGED_MD[@]}" >&2; then
                echo >&2
                echo "❌ pre-commit: в inline-коде есть конструкции, ломающиеся в zsh." >&2
                echo "   Почини по подсказкам выше. Обход (редко): git commit --no-verify" >&2
                FAIL=1
            fi
        fi
    fi
fi

# ===========================================================================
# 4. ПРИВАТНЫЕ ДАННЫЕ ОПЕРАТОРА в публичном репозитории (C.4, C.5)
#    Проверяется на ЛЮБОМ коммите, без условия «какие файлы тронуты»: утечка не
#    привязана к каталогу — она уезжает туда, где о ней не думают. Именно так
#    04.08.2026 в `knowledge/_reference/` оказался клиентский UUID VLESS вместе с
#    пятью узлами подписки — полный комплект доступа в открытом доступе.
#    Штатный сканер секретов это НЕ ловит: gitleaks знает форматы токенов известных
#    сервисов, а «UUID рядом со словом Blanc» для него обычная строка.
# ===========================================================================
PRIVLINT="$ROOT/scripts/check-private-data.sh"
if [ ! -f "$PRIVLINT" ]; then
    echo "⚠️  pre-commit: линтер приватных данных не найден ($PRIVLINT) — пропускаю." >&2
elif [ -n "$STAGED" ]; then
    echo "pre-commit: проверяю, нет ли приватных данных оператора…" >&2
    # --staged: читаем версии ИЗ ИНДЕКСА, а не с диска. Иначе `git add` плохой
    # версии с последующей правкой файла давал бы «чисто» при грязном коммите.
    if ! ( cd "$ROOT" && bash "$PRIVLINT" --staged >&2 ); then
        echo >&2
        echo "❌ pre-commit: в коммите приватные данные (адреса инфраструктуры или ключи)." >&2
        echo "   Репозиторий ПУБЛИЧНЫЙ. Убери значения — универсальному знанию они не нужны," >&2
        echo "   конкретика живёт в inventory/ оператора и в менеджере паролей." >&2
        echo "   Если значение уже утекало — удаления мало, нужна ротация: история публична." >&2
        echo "   Обход (редко, осознанно): git commit --no-verify" >&2
        FAIL=1
    fi
fi

# ===========================================================================
# 5. СЕКРЕТЫ — gitleaks по staged-изменениям (конституция C.5). Проверяется ВСЕГДА,
#    независимо от того, какие файлы тронуты: секрет может утечь в любом файле.
#    Внесено по PR #9 (ostrovskid): хук проверял персону, знания, маршруты,
#    переносимость и приватные данные — но не секреты, хотя C.5 требует именно этого.
# ===========================================================================
# Fail-closed: нет gitleaks — коммит отклоняется. Причина: «предупредил и пропустил»
# создаёт ложное чувство защиты, а цена пропущенного секрета несоизмеримо выше цены
# установки инструмента (утёкший секрет требует и ротации, и переписывания истории).
# Правила — .gitleaks.toml в корне: стандартный набор gitleaks плюс токен
# Telegram-бота, который базовый набор 8.30.1 не ловит.
if command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: проверяю staged-изменения на секреты…" >&2
    if ! ( cd "$ROOT" && gitleaks git --staged --no-banner --redact >&2 ); then
        echo >&2
        echo "❌ pre-commit: gitleaks нашёл потенциальный секрет в staged-изменениях." >&2
        echo "   Секреты живут в менеджере паролей, в git — только ссылка на запись (C.5)." >&2
        echo "   Ложное срабатывание → точечное исключение в .gitleaks.toml, а не отключение проверки." >&2
        FAIL=1
    fi
else
    echo "❌ pre-commit: gitleaks не найден — коммит заблокирован (проверка секретов обязательна, C.5)." >&2
    echo "   Установка: https://github.com/gitleaks/gitleaks#installing" >&2
    echo "   macOS: brew install gitleaks   ·   Linux/Windows: см. ссылку выше." >&2
    echo "   Обход в исключительном случае (НЕ по привычке): git commit --no-verify" >&2
    FAIL=1
fi

if [ "$FAIL" -ne 0 ]; then
    echo >&2
    echo "🔴 pre-commit ЗАБЛОКИРОВАН — см. причины выше." >&2
fi
exit "$FAIL"
