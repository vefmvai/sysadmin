# Личная конфигурация агента — НИКОГДА не коммитится в публичный репо.
# Содержит имя оператора, реальные пути к проектам, менеджер паролей (ADR-0013).
agent-config.json
# Личная карта инфры — если оператор работает прямо в sysadmin/ (ADR-0013).
infra-config.json

# Публичные шаблоны и схемы — коммитятся (negation override правила выше)
!agent-config.example.json
!agent-config.schema.json
!infra-config.example.json
!infra-config.schema.json

# Старое имя конфига (до ADR-0013) — у пользователя может остаться legacy-файл,
# его не коммитим. Публичные шаблоны sysadmin-config.* удалены в 1.12.0 (заменены
# agent-config.* + infra-config.*), поэтому negation-правил для них больше нет.
sysadmin-config.json

# Бэкап-копии конфигов и любых файлов (создаются /sysadmin-init при миграции,
# sed -i.bak и т.п.) — личные данные не должны уехать в коммит (P17).
*.bak
*.bak.*

# «Конфликтные копии» облачных синхронизаторов (Яндекс.Диск, Dropbox и т.п.) —
# появляются при работе с двух машин, в репо им не место (P20).
*конфликтная копия*
*conflicted copy*

# Мусор macOS
.DS_Store
._*

# Редакторские
.vscode/
.idea/
*.swp

# Claude Code служебные файлы
.claude/scheduled_tasks.lock

# Личные пользовательские настройки Claude Code (ADR-0015, задача 2.3): персональные
# переопределения оператора. Общие настройки команды — в tracked .claude/settings.json
# (если понадобятся). Вход «открыл папку → ты сисадмин» обеспечивает CLAUDE.md, а НЕ
# settings.json `agent` (см. ADR-0015), поэтому settings.json не обязателен.
.claude/settings.local.json

# Метка последней проверки обновлений (у каждого оператора своя)
.update-check

# Локальный список приватных значений оператора для замка check-private-data.sh
# (правило R3: домены, хостнеймы, ssh-алиасы, имена проектов). Шапка замка обещает,
# что файл лежит ВНЕ git — иначе он сам стал бы утечкой. До 05.08.2026 обещание ничем
# не подпиралось: проверщик создал файл и `git status` показал его как неотслеживаемый,
# то есть его можно было закоммитить. Теперь подпёрто.
.private-denylist.local

# Результаты прогона evals — артефакты сессии, не часть репо.
# Раннер — scripts/run-evals.sh (см. ADR-0004).
.eval-results/

# Временные артефакты ревизий и audit-сессий (Explore-агенты,
# промежуточные отчёты) — не часть репо.
.audit-tmp/

# Сырые разборы сессий /retro — цитируют инфру оператора (IP, домены), PII.
# В git — только обезличенный retro/BACKLOG.md и retro/README.md (ADR-0017).
retro/reviews/

# Живой слой VPN-знаний (_live, TTL 14 дней) — у каждого пользователя свой,
# обновляется /refresh-vpn-knowledge. В git — только шаблоны *.example.md
# и .gitkeep (задача 0.6 рефакторинга, P13: иначе у пользователя навсегда
# грязное дерево и конфликты при обновлении мозга).
.claude/knowledge/networking/_live/*.md
!.claude/knowledge/networking/_live/*.example.md

# Python bytecode-кэш (артефакт py_compile/импорта)
__pycache__/
*.pyc
# Артефакты Playwright MCP (снапшоты/логи браузерной диагностики) — не часть мозга
.playwright-mcp/

# Локальный рабочий handoff (не публикуется)
HANDOFF-v2.4.0.md

# Ретро-разборы сессий (цитаты, PII) — не коммитить
_retro/

# случайный скриншот, попавший в коммит 3cf6586 через git add -A (27.07.2026)
vscode-mobile-390.png
